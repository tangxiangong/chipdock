<Project Sdk="Microsoft.NET.Sdk">
  <!-- Portable driver policies and simulations, updates, Windows USB discovery and the Rust/C# bridge.
       Run with the built flashdesk_csharp library to include the bridge checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlashDesk</RootNamespace>
    <AssemblyName>FlashDesk.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Compile Include="../FlashDesk/Services/UpdateFeed.cs" Link="Linked/UpdateFeed.cs" />
    <Compile Include="../FlashDesk/Services/UpdateSource.cs" Link="Linked/UpdateSource.cs" />
    <Compile Include="../FlashDesk/Services/RustCore.cs" Link="Linked/RustCore.cs" />
    <Compile Include="../FlashDesk/Services/ProbeDriver.cs" Link="Linked/ProbeDriver.cs" />
    <Compile Include="../FlashDesk/Services/ProbeUsb.cs" Link="Linked/ProbeUsb.cs" />
    <Compile Include="../FlashDesk/Services/ProbeDriverRules.cs" Link="Linked/ProbeDriverRules.cs" />
    <Compile Include="../FlashDesk/Generated/*.cs" Link="Generated/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
