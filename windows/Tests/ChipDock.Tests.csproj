<Project Sdk="Microsoft.NET.Sdk">
  <!-- Portable driver policies and simulations, updates, Windows USB discovery and the Rust/C# bridge.
       Run with the built chipdock_csharp library to include the bridge checks. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChipDock</RootNamespace>
    <AssemblyName>ChipDock.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Compile Include="../ChipDock/UpdateFeed.cs" Link="Linked/UpdateFeed.cs" />
    <Compile Include="../ChipDock/UpdateSource.cs" Link="Linked/UpdateSource.cs" />
    <Compile Include="../ChipDock/NativeWorker.cs" Link="Linked/NativeWorker.cs" />
    <Compile Include="../ChipDock/SerialBackend.cs" Link="Linked/SerialBackend.cs" />
    <Compile Include="../ChipDock/SerialAutoSender.cs" Link="Linked/SerialAutoSender.cs" />
    <Compile Include="../ChipDock/RustCore.cs" Link="Linked/RustCore.cs" />
    <Compile Include="../ChipDock/RecentFirmwareHistory.cs" Link="Linked/RecentFirmwareHistory.cs" />
    <Compile Include="../ChipDock/ActivityText.cs" Link="Linked/ActivityText.cs" />
    <Compile Include="../ChipDock/WindowLayout.cs" Link="Linked/WindowLayout.cs" />
    <Compile Include="../ChipDock/ProbeDriver.cs" Link="Linked/ProbeDriver.cs" />
    <Compile Include="../ChipDock/ProbeUsb.cs" Link="Linked/ProbeUsb.cs" />
    <Compile Include="../ChipDock/ProbeDriverRules.cs" Link="Linked/ProbeDriverRules.cs" />
    <Compile Include="../../bindings/generated/csharp/*.cs" Link="Generated/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
