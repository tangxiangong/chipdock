<Application x:Class="FlashDesk.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
   </ResourceDictionary.MergedDictionaries>
   <!-- Views are built in code; styles keep ThemeResource references live,
        so colours follow per-window theme changes. -->
   <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>
   <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="TertiaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
   </Style>
   <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
   </Style>
   <Style x:Key="CriticalTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
   </Style>
   <Style x:Key="CriticalGlyphStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
   </Style>
   <Style x:Key="SecondaryGlyphStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="AccentGlyphStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
   </Style>
   <Style x:Key="ContentLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="CornerRadius" Value="8,0,0,0" />
   </Style>
   <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
   </Style>
   <Style x:Key="WellStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="DividerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
   </Style>
   <Style x:Key="AccentFillStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
   </Style>
   <Style x:Key="DropZoneStyle" TargetType="Rectangle">
    <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
    <Setter Property="Fill" Value="Transparent" />
   </Style>
   <Style x:Key="DropZoneTargetedStyle" TargetType="Rectangle">
    <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
   </Style>
   <Style x:Key="DropOverlayStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
   </Style>
   <Style x:Key="ConnectedDotStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
   </Style>
   <Style x:Key="IdleDotStyle" TargetType="Ellipse">
    <Setter Property="Fill" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
