<UserControl
    x:Class="ChipDock.SerialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChipDock">
  <Grid x:Name="Root" Loaded="OnLoaded" SizeChanged="OnRootSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="SerialViewport" Grid.Row="0" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="OnRootSizeChanged">
      <SplitView x:Name="SerialSurface" OpenPaneLength="216" IsPaneOpen="True" DisplayMode="Inline"
                 PaneClosed="OnConnectionPaneClosed" SizeChanged="OnRootSizeChanged">
      <SplitView.Pane>
      <Grid x:Name="ConnectionPanel" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="18,16">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE88E;" FontSize="16" />
            <TextBlock Text="串口设置" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="18" Spacing="18">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="PortPicker" Header="串口设备" PlaceholderText="未发现串口" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="串口设备" SelectionChanged="OnSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{Binding Path}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Bottom" Width="32" Height="32"
                      Padding="0" Click="OnRefresh" Background="Transparent" BorderThickness="0"
                      AutomationProperties.Name="刷新串口" ToolTipService.ToolTip="刷新串口 (Ctrl+R)">
                <SymbolIcon Symbol="Refresh" />
              </Button>
            </Grid>
            <ComboBox x:Name="BaudPicker" Header="波特率" HorizontalAlignment="Stretch" IsEditable="True"
                      SelectionChanged="OnSelectionChanged" TextSubmitted="OnBaudTextSubmitted"
                      ToolTipService.ToolTip="输入自定义波特率，或选择常用值；范围 1–4294967295。" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="DataBitsPicker" Header="数据位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
              <ComboBox x:Name="StopBitsPicker" Grid.Column="1" Header="停止位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
            </Grid>
            <ComboBox x:Name="ParityPicker" Header="校验位" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
            <ComboBox x:Name="FlowPicker" Header="流控制" HorizontalAlignment="Stretch" SelectionChanged="OnSelectionChanged" />
            <Button x:Name="ConnectButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}" Click="OnConnect"
                    ToolTipService.ToolTip="连接或断开串口 (Ctrl+K)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon x:Name="ConnectIcon" Symbol="Link" />
                <TextBlock x:Name="ConnectLabel" Text="连接串口" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </SplitView.Pane>
      <SplitView.Content>
      <Grid x:Name="Workspace" Background="{ThemeResource LayerFillColorDefaultBrush}" SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="180" />
          <RowDefinition x:Name="ComposerSplitterRow" Height="5" />
          <RowDefinition x:Name="ComposerRow" Height="190" MinHeight="164" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" SizeChanged="OnRootSizeChanged" />

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="ReceiveToolbar" Padding="18,8" ColumnSpacing="12" RowSpacing="8" MinHeight="56"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" MaxWidth="220" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="ConnectionPaneToggle" IsChecked="True" Width="32" Height="32" Padding="0"
                          VerticalAlignment="Center" Click="OnToggleConnectionPane"
                          AutomationProperties.Name="连接区" ToolTipService.ToolTip="收起连接区">
              <FontIcon Glyph="&#xE90C;" FontSize="16" />
            </ToggleButton>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <SymbolIcon Symbol="AlignLeft" />
              <TextBlock Text="接收区" FontSize="13" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>
            <TextBlock x:Name="FrameCount" Grid.Column="2" Text="0 条" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="DirectionPicker" Grid.Column="4" SelectedIndex="0" Width="112" VerticalAlignment="Center"
                      AutomationProperties.Name="数据方向" SelectionChanged="OnFilterChanged">
              <ComboBoxItem Content="全部" />
              <ComboBoxItem Content="接收 RX" />
              <ComboBoxItem Content="发送 TX" />
            </ComboBox>
            <TextBox x:Name="TerminalSearch" Grid.Column="5" PlaceholderText="搜索数据" VerticalAlignment="Center"
                     AutomationProperties.Name="搜索终端数据" ToolTipService.ToolTip="搜索数据 (Ctrl+F)" TextChanged="OnSearchChanged" />
          </Grid>

          <Grid Grid.Row="1">
            <ListView x:Name="Terminal" SelectionMode="Extended" AutomationProperties.Name="串口数据终端"
                      Background="Transparent" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="18,8" />
                  <Setter Property="MinHeight" Value="34" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TerminalFrame">
                  <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Time}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <Viewbox Width="12" Height="12">
                        <SymbolIcon Symbol="{x:Bind DirectionIcon}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </Viewbox>
                      <TextBlock Text="{x:Bind Direction}" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <TextBlock Text="{x:Bind Size}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               FontFamily="Consolas" FontSize="13" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12" Margin="24" MaxWidth="320">
              <FontIcon x:Name="EmptyIcon" Glyph="&#xE756;" FontSize="32" HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
              <TextBlock x:Name="EmptyTitle" Text="暂无收发记录" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyDescription" Text="在左侧选择串口并连接，即可开始收发。" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button x:Name="ResetFiltersButton" Content="清除筛选" Click="OnResetFilters" HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ReceiveOptions" Grid.Row="2" Padding="18,8" ColumnSpacing="12" RowSpacing="8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="接收编码" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="DisplayPicker" Grid.Column="1" MinWidth="96" VerticalAlignment="Center"
                      AutomationProperties.Name="接收编码" SelectionChanged="OnDisplayChanged" />
            <ToggleButton x:Name="AutoScrollToggle" Grid.Column="3" IsChecked="True" Click="OnAutoScroll"
                          VerticalAlignment="Center" ToolTipService.ToolTip="跟随最新的数据">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <SymbolIcon Symbol="Download" />
                <TextBlock Text="自动滚动" FontSize="12" />
              </StackPanel>
            </ToggleButton>
            <Button x:Name="ExportButton" Grid.Column="4" Click="OnExport" VerticalAlignment="Center"
                    AutomationProperties.Name="导出串口记录为 JSON" ToolTipService.ToolTip="将当前保留的全部收发记录导出为 JSON（不受筛选影响）">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xEDE1;" />
                <TextBlock Text="导出" FontSize="12" />
              </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Grid.Column="5" Click="OnClear" VerticalAlignment="Center" ToolTipService.ToolTip="清空终端 (Ctrl+L)">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <SymbolIcon Symbol="Delete" />
                <TextBlock Text="清屏" FontSize="12" />
              </StackPanel>
            </Button>
            <ToggleButton x:Name="ComposerPaneToggle" Grid.Column="6" IsChecked="True" Padding="10,4"
                          VerticalAlignment="Center" Click="OnToggleComposerPane"
                          AutomationProperties.Name="收起发送区" ToolTipService.ToolTip="收起发送区">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="ComposerPaneChevron" Glyph="&#xE70D;" FontSize="12" />
                <TextBlock x:Name="ComposerPaneLabel" Text="收起发送区" FontSize="12" />
              </StackPanel>
            </ToggleButton>
          </Grid>
        </Grid>

        <Thumb x:Name="ComposerSplitter" Grid.Row="2" HorizontalAlignment="Stretch" DragDelta="OnComposerResize" KeyDown="OnSplitterKeyDown"
               IsTabStop="True" AutomationProperties.Name="调整收发区域高度" ToolTipService.ToolTip="拖动调整收发区域；方向键微调">
          <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Border Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Border Width="28" Height="3" CornerRadius="2" HorizontalAlignment="Center"
                        Background="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </ControlTemplate>
          </Thumb.Template>
        </Thumb>

        <Grid x:Name="ComposerPanel" Grid.Row="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="SendOptions" Padding="18,8" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SendHeading" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <SymbolIcon Symbol="Edit" />
              <TextBlock Text="发送区" FontSize="13" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            </StackPanel>
            <ComboBox x:Name="ChecksumPicker" Grid.Column="1" Width="156" VerticalAlignment="Center"
                      AutomationProperties.Name="发送校验算法" SelectionChanged="OnSelectionChanged"
                      ToolTipService.ToolTip="校验码在行尾之前追加；奇偶校验追加 0 或 1，CRC16 使用 MODBUS 格式。" />
            <TextBlock x:Name="SendEncodingLabel" Grid.Column="2" Text="编码" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="SendFormatPicker" Grid.Column="3" Width="96" VerticalAlignment="Center"
                      AutomationProperties.Name="发送编码" SelectionChanged="OnSelectionChanged" />
            <TextBlock x:Name="SendEndingLabel" Grid.Column="4" Text="行尾" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="EndingPicker" Grid.Column="5" Width="80" VerticalAlignment="Center"
                      AutomationProperties.Name="发送行尾" SelectionChanged="OnSelectionChanged" />
          </Grid>
          <TextBox x:Name="InputBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="输入文本或设备指令…"
                   Padding="18,8" Background="Transparent" BorderThickness="0" CornerRadius="0" FontFamily="Consolas" FontSize="13"
                   AutomationProperties.Name="要发送的数据" TextChanged="OnInputChanged" />
          <Grid x:Name="ComposerActions" Grid.Row="2" Padding="18,8,18,14" ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="IntervalOptions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="间隔" FontSize="12" VerticalAlignment="Center" />
              <NumberBox x:Name="AutoSendInterval" Width="96" Minimum="10" Maximum="3600000" Value="1000"
                         SpinButtonPlacementMode="Hidden" ValueChanged="OnAutoSendIntervalChanged"
                         AutomationProperties.Name="自动发送间隔，毫秒" ToolTipService.ToolTip="每次发送完成后等待 10–3600000 毫秒。" />
              <TextBlock Text="ms" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="AutoSendButton" Grid.Column="1" Click="OnAutoSend" ToolTipService.ToolTip="立即发送一次，之后按间隔重复发送；断开连接或发送失败时停止。">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="AutoSendIcon" Glyph="&#xE8EE;" FontSize="14" />
                <TextBlock x:Name="AutoSendLabel" Text="自动发送" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="InputCount" Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="SendButton" Grid.Column="4" MinWidth="88" Style="{ThemeResource AccentButtonStyle}"
                    Click="OnSend" ToolTipService.ToolTip="发送数据 (Ctrl+Enter)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Send" />
                <TextBlock x:Name="SendLabel" Text="发送" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Grid>
      </SplitView.Content>
      </SplitView>
    </ScrollViewer>

    <Grid Grid.Row="1" Padding="16,8" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ConnectionStatus" Text="未连接" FontSize="12" TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="ByteStatus" Grid.Column="1" Text="RX 0 B    TX 0 B" FontSize="12" FontFamily="Consolas"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
  </Grid>
</UserControl>
