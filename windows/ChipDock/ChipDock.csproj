<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChipDock</RootNamespace>
    <AssemblyName>ChipDock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ChipDock.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <Version>0.2.0</Version>
    <Title>ChipDock</Title>
    <Product>ChipDock</Product>
    <Description>ChipDock 嵌入式开发工具集</Description>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <!-- Program.Main provisions Windows App Runtime before any WinUI type loads. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!-- ECDSA P-256 public key (base64 SPKI) that verifies the signed update feed.
         Its private key is the WINDOWS_UPDATE_PRIVATE_KEY secret of the release environment. -->
    <UpdatePublicKey Condition="'$(UpdatePublicKey)' == ''">MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEQLGXDisZfYQ00atl+P9u9pxcQPEBVEjs4UTJheaqW+BsNyj/zeN6VYkFsvok85QN3K8YIrqDinG2QqHl3BaJMg==</UpdatePublicKey>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\ChipDock.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ChipDock.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Build/Rust.targets" />
  <Import Project="Build/Publish.targets" />
</Project>
