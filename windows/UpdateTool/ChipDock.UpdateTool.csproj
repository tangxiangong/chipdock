<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release-side counterpart of the app's update verification. Portable, so the
       publish job can verify every architecture's feed on any runner. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ChipDock</RootNamespace>
    <AssemblyName>ChipDock.UpdateTool</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Compile Include="../ChipDock/UpdateFeed.cs" Link="UpdateFeed.cs" />
  </ItemGroup>
</Project>
