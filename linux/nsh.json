    "minSize": {
      "width": 900,
      "height": 652
    },
    "closeOnPress": false,
    "restoreBounds": true,
    "defaultSize": {
      "width": 1160,
      "height": 780
    }
  },
  "icon": "../windows/ChipDock/Assets/ChipDock.png"
}
