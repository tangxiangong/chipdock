{
  "name": "ChipDock",
  "id": "com.xiaoyu.chipdock",
  "version": "0.3.0",
  "build": 1,
  "rust": ".",
  "root": "App",
  "theme": "theme.json",
  "appearance": "system",
  "window": {
    "titleBar": {
      "style": "hidden",
      "height": 52,
      "controlsOffset": {
        "x": 19,
        "y": 19
